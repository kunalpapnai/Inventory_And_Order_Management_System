# ==============================================================================
# StockFlow — Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Server Port
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Atlas Credentials
DB_USERNAME=admin
DB_PASSWORD=your_mongodb_password

# Or specify a custom direct connection string:
# MONGO_URI=mongodb+srv://admin:<password>@cluster0.ifwh6.mongodb.net/inventory_order_db?retryWrites=true&w=majority&appName=Cluster0

# JSON Web Token Authentication Secrets
JWT_SECRET=super_secret_jwt_key_inventory_2026_dev_mode
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:3000

# Low Stock Alert Threshold for Dashboard & Inventory Alerts
LOW_STOCK_THRESHOLD=10

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------
# API Base URL for Client Requests
NEXT_PUBLIC_API_URL=http://localhost:5000/api
